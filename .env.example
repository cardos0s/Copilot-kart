# Copilot — Live Sharing (opcional)
# Pegar no Supabase Dashboard → Project Settings → API
# Sem essas vars o app funciona normalmente, só sem live sharing.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Copilot — Coach IA via Claude (opcional)
# Pegar em https://console.anthropic.com (Settings → API Keys)
# Sem essa var, o botão "Coach IA" mostra mensagem pedindo pra configurar.
# ⚠️ Embedded no APK — pra MVP/pessoal ok, pra produção use backend proxy.

EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-...
# Opcional — sobrescreve o modelo default (claude-sonnet-4-5)
# EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-4-5
