{
  "expo": {
    "name": "Copilot",
    "slug": "kartlap",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kartlap",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "package": "com.cortextech.copilot",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "O KartLap usa sua localização para gravar a trajetória na pista.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O KartLap precisa da localização em segundo plano para continuar gravando quando a tela estiver apagada.",
        "NSMotionUsageDescription": "O KartLap usa sensores de movimento para melhorar a precisão da trajetória."
      }
    },
    "android": {
      "package": "com.cortextech.copilot",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O KartLap precisa da localização em segundo plano para gravar a volta completa.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76fe31f3-ad5e-421c-bf9b-307e71ae6e7c"
      }
    },
    "owner": "jucsantana0"
  }
}
